# Copy this file to `.env` for local runs (it is gitignored — never commit real values).
# The VS Code Python extension loads `.env` automatically when you run/debug.
# On a Databricks cluster none of these are needed: ENV defaults to PROD and the
# job supplies DatabrickTaskID via a widget.

# Target environment — selects the section in config.yaml (DEV/UAT/QA/PROD) and the DB host.
ENV=DEV

# databricks-connect target (local runs attach to this remote cluster).
DATABRICKS_CONFIG_PROFILE=dev
DATABRICKS_CLUSTER_ID=0000-000000-xxxxxxxx

# Task id to forecast locally (stands in for the Databricks job widget).
DATABRICK_TASK_ID=4

# Optional — only needed if a code path uses SQL auth instead of the cluster's
# managed identity. Leave unset to rely on Authentication=ActiveDirectoryMSI.
# DB_USER=fortrackSQL
# DB_PASSWORD=

# Local fixture for unbundled mode (bypasses Spark/ForecastDataset)
PREDICTIVE_FIXTURE_PATH=data/fixtures/unbundled_predictive_input.parquet
