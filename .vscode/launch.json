{
  // Run configs for the bundled/unbundled forecasting paths.
  //
  // `.env` is loaded automatically by the VS Code Python extension; each config below
  // only overrides what it needs. Copy `.env.example` → `.env` first.
  //
  // The interpreter is deliberately NOT pinned here — VS Code uses the workspace
  // interpreter, so this file stays portable across machines and into the ADO repo.
  //
  // Two flags, easily confused:
  //   --mode unbundled   → arms the OFFLINE gate (maybe_run_offline); needs PREDICTIVE_FIXTURE_PATH
  //   UNBUNDLED=true     → selects the unbundled LOOP on a live run
  // A live run must NOT pass `--mode unbundled`, or it diverts to the fixture and exits.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESF-SARIMA (Unbundled, offline fixture)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ESF-SARIMA.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["--mode", "unbundled"],
      "env": {
        "UNBUNDLED": "true",
        "PREDICTIVE_FIXTURE_PATH": "data/fixtures/unbundled_predictive_input.parquet"
      }
    },
    {
      "name": "ESF-SARIMA (Unbundled, live DEV)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ESF-SARIMA.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      // No `--mode unbundled`, and the fixture path is cleared: both are required or
      // maybe_run_offline() diverts to the local fixture and never reaches the cluster.
      "env": {
        "ENV": "DEV",
        "UNBUNDLED": "true",
        "PREDICTIVE_FIXTURE_PATH": ""
      }
    },
    {
      "name": "ESF-SARIMA (Bundled, live DEV)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ESF-SARIMA.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV": "DEV",
        "UNBUNDLED": "false",
        "PREDICTIVE_FIXTURE_PATH": ""
      }
    },
    {
      // BLOCKED until plan 06 lands: maybe_run_offline() currently gates on
      // `--mode unbundled`, so there is no offline fixture path for bundled.
      // Plan 12 task: extend the offline gate to accept `--mode bundled`.
      "name": "ESF-SARIMA (Bundled, offline fixture) [needs plan 06]",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ESF-SARIMA.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["--mode", "bundled"],
      "env": {
        "UNBUNDLED": "false",
        "PREDICTIVE_FIXTURE_PATH": "data/fixtures/unbundled_predictive_input.parquet"
      }
    },
    {
      "name": "Gradio dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/forecasting/dashboard_app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },

    // ---- Plan checkpoints (F5 wrappers around each plan's Engagement Instructions) ----
    // Each maps 1:1 to a plan's pytest command. Configs for tests that do not exist yet
    // will report "file not found" until the owning plan lands — that is the intended signal.
    {
      "name": "Debug: test_bundle_aggregation (plan 04)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_bundle_aggregation.py", "-v"]
    },
    {
      "name": "Debug: test_bundle_disaggregation (plan 05)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_bundle_disaggregation.py", "-v"]
    },
    {
      "name": "Debug: test_run_forecast_dispatch (plan 06)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_run_forecast_dispatch.py", "-v"]
    },
    {
      "name": "Debug: test_bundled_loop + coherence (plan 11)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_bundled_loop.py", "tests/test_bundle_coherence.py", "-v"]
    },
    {
      "name": "Debug: test_bundle_error_boundary (plan 10)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_bundle_error_boundary.py", "-v"]
    },
    {
      "name": "Debug: test_offset_active (plan 03)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_offset_active.py", "-v"]
    },
    {
      "name": "Debug: test_statistical_indicator (plan 07)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_statistical_indicator.py", "-v"]
    },
    {
      "name": "Debug: test_brs_validation (plan 08)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": ["tests/test_brs_validation.py", "-v"]
    },
    {
      "name": "Build bundle fixture (plan 09)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_bundle_fixture.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Reference: unbundled suite (must stay green)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "tests/test_unbundled_loop.py",
        "tests/test_forecast_fact_preview.py",
        "-v"
      ]
    }
  ]
}
